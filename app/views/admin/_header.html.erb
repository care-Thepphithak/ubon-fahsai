<div class="w-full flex mx-auto">
    <div class="flex flex-col mt-4 items-start w-[90%] max-w-[1300px] mx-auto text-white justify-center h-full relative">
        <div class="w-full flex justify-between items-center">
          <div>
            <h1 class="text-xl ml-1">Admin</h1>
            <p class="font-medium text-5xl">อุบลฟ้าใส</p>
          </div>
          
          <div class="justify-center h-full pt-4 lg:flex hidden">
            <% if authenticated? %>
              <span class="mr-4 text-gray-50 pt-2 truncate">
                <i class="fa-solid fa-circle-user pr-2"></i><%= Current.user.email_address %>
              </span>
              <%= button_to session_path, method: :delete, class: "px-4 py-2 rounded-lg flex bg-[#F3F3F3] gap-2 items-center text-gray-500 text-base cursor-pointer hover:bg-gray-200 transition-all" do %>
                <i class="fa fa-sign-out-alt"></i>
                <span>ออกจากระบบ</span>
              <% end %>
            <% end %>
          </div>

          <div class="justify-center h-full pt-4 lg:hidden flex">
            <% if authenticated? %>
              <button data-action="click->sidebar#toggle" class="p-2 rounded-lg flex gap-2 items-center text-white text-3xl cursor-pointer hover:scale-110 transition-all">
                <i class="fa-solid fa-bars"></i>
              </button>
            <% end %>
          </div>
        </div>

        <div class="flex items-center gap-1 w-full text-gray-50 font-light transition-all mt-8 text-xl">
            <%= breadcrumb_links %>
        </div>
    </div>
</div>