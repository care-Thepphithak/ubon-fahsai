<div class="w-[350px] h-svh bg-gray-100">
    <div class="flex items-center justify-center text-3xl text-[#FF6159] mb-5 mt-4">
        <i class="fa-solid fa-chart-pie mr-3"></i> <span class="font-medium">Admin</span>
    </div>
    <div class="flex flex-col items-center gap-3 px-6">
        <%= link_to admin_dashboard_index_url, 
            class: "px-4 py-3 w-full rounded-lg #{active_link_class(admin_dashboard_index_url)}" do %>
        <i class="fa-solid fa-house mr-2 h-7 w-7"></i> Dashboard
        <% end %>
        
        <%= link_to admin_areas_path, 
            class: "px-4 py-3 w-full rounded-lg #{active_link_class(admin_areas_path)}" do %>
        <i class="fa-solid fa-map mr-2 h-7 w-7"></i> Area Management
        <% end %>
    </div>
</div>