<div class="w-full xl:w-[500px] 2xl:w-[600px] bg-[#F3F3F3] flex flex-col p-5 rounded-xl" data-controller="admin-filter" data-admin-filter-reports-value="<%= @reports.to_json %>">
    <div class="mb-4">
        <p class="mb-2 text-lg text-gray-500">กรองข้อมูล</p>
        <div class="relative w-full mt-2">
            <%= form_tag admin_dashboard_index_path, method: :get do %>
                <select name="filter" 
                        onchange="this.form.requestSubmit()"
                        class="bg-white text-gray-500 p-2 rounded-lg w-full appearance-none outline-none hover:bg-gray-50 transition-all cursor-pointer">
                    <option value="today" <%= 'selected' if params[:filter] == 'today' %>>การรายงานวันนี้</option>
                    <option value="all" <%= 'selected' if params[:filter] == 'all' %>>การรายงานทั้งหมด</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
                <i class="fa-solid fa-angle-down"></i>
                </div>
            <% end %>
        </div>
        <div class="flex gap-2 mt-2">
            <div class="relative w-full">
                <select id="dateFilter" class="bg-white text-gray-500 p-2 rounded-lg w-full appearance-none outline-none hover:bg-gray-50 transition-all cursor-pointer" data-action="change->admin-filter#filterByDateRange">
                <option value="latest">ล่าสุด</option>
                <option value="oldest">เก่าสุด</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
                <i class="fa-solid fa-angle-down"></i>
                </div>
            </div>
            <div class="relative w-full">
                <select id="tag-sort" class="bg-white text-gray-500 p-2 rounded-lg w-full appearance-none outline-none hover:bg-gray-50 transition-all cursor-pointer" data-action="change->admin-filter#filterByTag">
                <option value="">ทั้งหมด</option>
                <% Report::TAGS.each do |tag| %>
                    <option value="<%= tag %>"><%= tag %></option>
                <% end %>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
                <i class="fa-solid fa-angle-down"></i>
                </div>
            </div>
        </div>
    </div>
    <p class="mb-2 text-lg text-gray-500">รายการสถานการณ์ไฟไหม้</p>
    <div class="flex flex-col gap-4 overflow-y-scroll no-scrollbar scroll-smooth rounded-lg" id="report-container" data-admin-filter-target="reportContainer">
        <div id="notifications" class="rounded flex flex-col gap-4"></div>
        <% @reports.each do |report| %>
        <div class="flex bg-white py-3 pr-[16px] rounded-lg hover:bg-gray-50 cursor-pointer transition-all" data-action="click->admin-map#setViewByList" data-lat="<%= report.lat %>" data-long="<%= report.long %>" >
            <div class="flex flex-col gap-1 min-w-14 mx-4 items-center justify-center text-nowrap">
            <svg width="40" height="46" viewBox="0 0 30 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.27344 35.0512C1.092 31.0038 -0.798717 27.1728 0.282262 21.9405C1.08029 18.077 3.69339 14.9336 3.94394 11.0775C5.06018 13.1088 5.52659 14.5736 5.65132 16.6963C9.20151 12.3466 11.5475 6.32517 11.6865 0C11.6865 0 20.9334 5.43323 21.5402 13.6402C22.3362 11.9486 22.7369 9.26193 21.9409 7.5207C24.329 9.26202 38.3067 24.7203 20.0476 35.0512C23.4805 28.367 20.9332 19.3479 14.9728 15.1825C15.3709 16.9736 14.673 23.6538 12.036 26.5892C12.7667 21.6845 11.3409 19.6105 11.3409 19.6105C11.3409 19.6105 10.8515 22.3578 8.95276 25.133C7.2189 27.6673 6.01752 30.357 8.27344 35.0512Z" fill="<%= report.severity_color %>"/>
            </svg>
            <p class="text-gray-500 text-sm" data-testid="severity-level"><%= report.severity_level %></p>
            </div>
            <div class="flex flex-col">
            <h2 class="font-normal text-gray-600 text-base line-clamp-2" data-testid="location-name"><%= report.location_name %></h2>
            <p class="text-gray-500 text-[14px]"><%= time_ago_in_words(report.created_at, datetime: :distance_in_words, locale: :th) %> ที่แล้ว</p>
            <div class="flex gap-2 mt-3 flex-wrap">
                <% tags = JSON.parse(report.tags) rescue [] %> 
                <% tags.each do |tag| %>
                <p class="px-2 py-1 text-gray-500 bg-gray-100 rounded-md font-normal" data-testid="tags"><%= tag || "ไม่มีข้อมูล" %></p>
                <% end %>
            </div>
            </div>
        </div>
        <% end %>
    </div>
</div>