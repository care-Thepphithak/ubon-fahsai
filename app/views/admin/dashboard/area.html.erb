<div class="w-full flex flex-col relative">

    <%= render "header"%>

    <div class="absolute pb-12 left-0 right-0 top-36 mx-auto flex flex-col xl:flex-row w-[90%] max-w-[1300px] h-svh min-h-[700px] mt-10 gap-[20px]">
      <div data-controller="area-map" class="flex flex-col md:flex-row w-full md:h-[12rem] mb-[20px] gap-[20px]">

        
        <div data-area-map-target="map" class="h-[600px] w-full rounded-xl"> </div>

        <div class="w-full xl:w-[500px] bg-[#F3F3F3] flex  flex-col p-5 rounded-xl" data-controller="admin-filter" data-admin-filter-reports-value="<%= @reports.to_json %>">
          <div class="flex gap-3 w-full">
            <button class="bg-white w-full text-gray-500 px-3 py-3 rounded-md hover:bg-gray-50 transition-all cursor-pointer" data-action="click->area-map#startEditPolygon">
              <i class="fa-solid fa-draw-polygon mr-2"></i> กำหนดพื้นที่
            </button>
            <button class="bg-white w-full text-gray-500 px-3 py-3 rounded-md hover:bg-gray-50 transition-all cursor-pointer" data-action="click->area-map#resetPolygon">
              <i class="fa-solid fa-trash mr-2"></i> รีเซ็ตพื้นที่
            </button>
          </div>
          <button disabled class="disabled:bg-gray-200 disabled:text-gray-400 bg-[#FF6159] w-full text-white mt-3 px-3 py-3 rounded-md hover:bg-[#fb5951] transition-all cursor-pointer" data-action="click->area-map#endEditPolygon">
            <i class="fa-solid fa-check mr-2"></i> บันทึกพื้นที่
          </button>
        </div>
      </div>
    </div>
</div>
