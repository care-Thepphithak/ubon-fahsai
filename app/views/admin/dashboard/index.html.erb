<div class="w-full flex flex-col relative">
    <div class="w-full flex mx-auto h-64 bg-[#FF6159]">
      <div class="flex flex-col items-start w-[90%] max-w-[1300px] mx-auto text-white justify-center h-full relative">
        <div class="w-full flex justify-between items-center">
          <h1 class="text-xl ml-1">Admin</h1>
          <div>
            <% if authenticated? %>
              <%= button_to session_path, method: :delete, class: "px-4 py-2 rounded-lg flex bg-[#F3F3F3] gap-2 items-center text-gray-500 text-base cursor-pointer hover:bg-gray-200 transition-all" do %>
                <i class="fa fa-sign-out-alt"></i>
                <span>ออกจากระบบ</span>
              <% end %>
            <% end %>
          </div>
        </div>
        <p class="font-medium text-5xl mb-16">อุบลฟ้าใส</p>
      </div>
    </div>


    <div class="absolute pb-12 left-0 right-0 top-36 mx-auto flex flex-col xl:flex-row w-[90%] max-w-[1300px] mt-10 gap-[20px]">
      <div data-controller="admin-map" class="container mx-auto" data-admin-map-reports-value="<%= @reports.to_json %>">
        <div class="flex w-[full] h-[12rem] mb-[20px] gap-[20px]">
          <div class="flex flex-col flex-5 bg-[#F3F3F3] rounded-xl p-5 gap-2">
            <p class="text-lg text-gray-500">สถิติการไฟไหม้</p>
            <div class="flex gap-[20px] w-full h-[80%]">
              <div class="bg-white flex flex-col flex-1 rounded-xl p-3 px-5 h-full justify-center">
                <p class="text-gray-500 text-left mb-2">พื้นที่ไฟไหม้</p>
                <div class="flex gap-4 justify-between">
                  <p class="text-5xl" id="report_counter"><%= @report_count %></p>
                  <div class="flex flex-col items-end">
                    <% if @report_count_comparisons[:more] %>
                      <p class="text-[#FF392F]">เพิ่มขึ้น <i class="fa-solid fa-chevron-up"></i></p>
                    <% elsif @report_count_comparisons[:less] %>
                      <p class="text-[#2fff4b]">ลดลง <i class="fa-solid fa-chevron-down"></i></p>
                    <% else %>
                      <p class="text-gray-500">เท่าเดิม <i class="fa-solid fa-minus"></i></p>
                    <% end %>
                    <p class="text-gray-400">การรายงาน</p>
                  </div>
                </div>
              </div>
              <div class="bg-white flex flex-col flex-1 rounded-xl p-3 px-5 h-full justify-center">
                <p class="text-gray-500 text-left mb-2">ระดับความรุนแรง</p>
                <div class="flex gap-4 justify-between">
                  <p class="text-5xl text-[#FF392F]" id="report_harmful_counter"><%= @report_harmful_count %></p>
                  <div class="flex flex-col items-end">
                    <% if @report_harmful_count_comparisons[:more] %>
                      <p class="text-[#FF392F]">เพิ่มขึ้น <i class="fa-solid fa-chevron-up"></i></p>
                    <% elsif @report_harmful_count_comparisons[:less] %>
                      <p class="text-[#2fff4b]">ลดลง <i class="fa-solid fa-chevron-down"></i></p>
                    <% else %>
                      <p class="text-gray-500">เท่าเดิม <i class="fa-solid fa-minus"></i></p>
                    <% end %>
                    <p class="text-gray-400">วิกฤติ</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex flex-col flex-4 bg-[#F3F3F3] rounded-xl p-5 gap-2">
            <p class="text-lg text-gray-500">สถิติไฟไหม้ตามพื้นที่</p>
            <div class="flex flex-col overflow-scroll gap-2 no-scrollbar">
            <% @top_locations.each do |location_name, count| %>
              <div class="flex bg-white rounded-lg px-3 py-1 justify-between">
                <p class="w-[60%] text-base"><%= location_name.district %></p>
                <p class="text-[#FF392F]"><%= location_name.district_count %> จุด</p>
              </div>
            <% end %>
            </div>
          </div>
        </div>
        <div data-admin-map-target="map" class="rounded-xl h-[70vh] z-0"></div>

        <div data-admin-map-target="modal" class="hidden">
          <%= render "shared/modal" do %>
            <div data-admin-map-target="fireImages" class="flex gap-2 no-scrollbar overflow-x-scroll rounded-lg"></div>

            <h1 data-admin-map-target="locationName" class="text-2xl font-semibold text-gray-700 mt-4 mb-1"></h1>
            <div class="flex items-center">
              <div class="px-4 py-2 rounded-lg bg-red-100 mr-4">
                <p data-admin-map-target="severityLevel" class="text-red-400 text-md font-semibold"></p>
              </div>
              <p data-admin-map-target="createdAt" class="text-gray-500 text-md"></p>
            </div>
                <p class="text-gray-500 text-lg mt-3 ">รายละเอียด</p>
                <div class="flex px-4 py-3 flex-col items-start w-ful bg-gray-100 rounded-lg my-2">
                  <span data-admin-map-target="description" class="text-gray-500 text-lg"></span>
                </div>
            <button data-action="click->admin-map#closeModal" class="bg-red-400 p-3 mt-4 rounded-lg text-xl w-full hover:bg-red-500 text-white "> ปิด</button>
          <% end %>
        </div>

      </div>
      <div class="w-full xl:w-[600px] h-screen bg-[#F3F3F3] flex  flex-col p-5 rounded-xl">
        <p class="mb-2 text-lg text-gray-500">รายการสถานการณ์ไฟไหม้</p>
        <div class="flex flex-col gap-4 overflow-y-scroll no-scrollbar scroll-smooth rounded-lg" id="report-container">
          <div id="notifications" class="rounded flex flex-col gap-4"></div>
          <% @reports.each do |report| %>
            <div class="flex bg-white py-3 pr-[16px] rounded-lg">
              <div class="flex flex-col gap-1 min-w-14 mx-4 items-center justify-center text-nowrap">
                <svg width="40" height="46" viewBox="0 0 30 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.27344 35.0512C1.092 31.0038 -0.798717 27.1728 0.282262 21.9405C1.08029 18.077 3.69339 14.9336 3.94394 11.0775C5.06018 13.1088 5.52659 14.5736 5.65132 16.6963C9.20151 12.3466 11.5475 6.32517 11.6865 0C11.6865 0 20.9334 5.43323 21.5402 13.6402C22.3362 11.9486 22.7369 9.26193 21.9409 7.5207C24.329 9.26202 38.3067 24.7203 20.0476 35.0512C23.4805 28.367 20.9332 19.3479 14.9728 15.1825C15.3709 16.9736 14.673 23.6538 12.036 26.5892C12.7667 21.6845 11.3409 19.6105 11.3409 19.6105C11.3409 19.6105 10.8515 22.3578 8.95276 25.133C7.2189 27.6673 6.01752 30.357 8.27344 35.0512Z" fill="<%= report.severity_color %>"/>
                </svg>
                <p class="text-gray-500 text-sm"><%= report.severity_level %></p>
              </div>
              <div class="flex flex-col">
                <h2 class="font-normal text-black text-base line-clamp-2"><%= report.location_name %></h2>
                <p class="text-gray-500 text-[14px]"><%= time_ago_in_words(report.created_at, datetime: :distance_in_words, locale: :th) %> ที่แล้ว</p>
                <div class="flex gap-1 mt-3 flex-wrap">
                  <% tags = JSON.parse(report.tags) rescue [] %> 
                  <% tags.each do |tag| %>
                    <p class="px-2 py-0.5 bg-gray-300 rounded-md font-normal"><%= tag || "ไม่มีข้อมูล" %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
</div>
