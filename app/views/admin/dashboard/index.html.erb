<%= turbo_frame_tag "dashboard" do %>
  <div data-controller="admin-map" data-admin-map-reports-value="<%= @reports.to_json %>">
    <div class="mx-auto flex flex-col xl:flex-row w-[90%] max-w-[1300px] xl:h-svh min-h-[600px] xl:max-h-[800px] mt-8 gap-[20px]">
      <div class="flex flex-col w-full mx-auto">
        <%= render "statistics" %>
        <%= render "map" %>
        <%= render "details_modal" %>
      </div>
      <%= render "reports" %>
    </div>
  </div>
<% end %>