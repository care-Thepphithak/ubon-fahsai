<div data-admin-map-target="modal" class="hidden">
    <%= render "shared/modal" do %>
    <div data-admin-map-target="fireImages" class="flex gap-2 no-scrollbar overflow-x-scroll rounded-lg"></div>

    <h1 data-admin-map-target="locationName" data-testid="modal-location-name" class="text-lg font-semibold text-gray-700 mt-4 mb-2"></h1>
    <div class="flex items-center">
        <div  class="px-3 py-1 rounded-lg bg-red-100 mr-4">
            <p data-testid="modal-severity-level" data-admin-map-target="severityLevel" class="text-red-400 font-semibold"></p>
        </div>
        <p data-admin-map-target="createdAt" class="text-gray-500"></p>
    </div>
        <p class="text-gray-500 text mt-3 ">รายละเอียด</p>
        <div class="flex px-4 py-3 flex-col items-start w-ful bg-gray-100 rounded-lg my-2">
            <span data-testid="modal-description" data-admin-map-target="description" class="text-gray-500"></span>
        </div>
        <button data-action="click->admin-map#closeModal" class="bg-[#FF6159] p-2 mt-4 rounded-lg w-full hover:bg-[#FF6C64] cursor-pointer transition-all text-white "> ปิด</button>
    <% end %>
</div>