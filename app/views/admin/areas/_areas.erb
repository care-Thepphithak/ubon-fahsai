<% @areas.each do |area| %>
    <div class="w-full flex gap-2">
        <button data-action="click->area-map#showArea" data-coordinates="<%= area.coordinates %>" class="w-full flex text-gray-600 justify-between hover:bg-gray-50 transition-all items-center bg-white p-2 rounded-lg mb-3 cursor-pointer">
        <p class="text-gray-600 text-start ml-2"><%= area.name %></p>
        </button>
        <%= link_to edit_admin_area_path(area), class: "px-3 flex text-gray-600 justify-between items-center bg-white p-2 rounded-lg mb-3 cursor-pointer hover:bg-gray-50 transition-all " do %>
        <i class="fa-solid fa-pen"></i>
        <% end %>
    </div>
<% end %>