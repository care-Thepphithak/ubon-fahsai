<% if notice %>
  <div data-controller="bottom-sheet" data-bottom-sheet-open="true">
    <%= render "shared/bottom_sheet" do %>
      <h2 class="text-2xl text-green-500 pb-[20px]"><i class="fas fa-check-circle"></i> รายงานสำเร็จ</h2>
      <p class="text-sm text-gray-500 pb-2"><%= l(Time.current, format: :full, locale: :th) %></p>
      <p id="location-name-bottom-sheet" class="text-center text-lg text-gray-500 pb-[30px]"><%= notice %></p>
    <% end %>
  </div>
<% end %>

<div class="m-4">
  <h1 class="font-medium text-4xl mb-6 text-[#FF6159]">อุบลฟ้าใส</h1>
  <%= link_to "รายงานไฟไหม้", reports_path, class: button_helper("ดูรายงาน", variant: :solid, size: :md, css_class: "inline-block px-4 py-2") %>
  <div class="grid mt-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @reports.each do |report| %>
      <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-md">
        <h2 class="font-semibold text-xl text-[#FF6159]"><%= report.location_name %></h2>
        <p class="text-gray-500">lat: <%= report.lat %>, long: <%= report.long %></p>
        <p class="text-gray-500">สร้างเมื่อ: <%= report.created_at %></p>
        <p class="text-gray-500">รายละเอียด <%= report.description %></p>
        <p class="text-gray-500">ระดับความรุนแรง: <%= report.severity_level %></p>
        <p class="text-gray-500 mb-3">
          Tags: <%= JSON.parse(report.tags).join(", ") rescue "ไม่มีข้อมูล" %>
        </p>
        <% if report.images.one? %>
          <%= image_tag report.images.first, class: "w-full h-64 object-cover rounded-lg" %>
        <% else %>
          <div class="grid grid-cols-2 gap-2">
            <% report.images.each do |image| %>
              <%= image_tag image, class: "w-full h-32 object-cover rounded-lg" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
