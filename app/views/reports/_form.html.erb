<%= form_with(model: report, class: "contents", data: { "report-step-value" => "0" }) do |form| %>
  <% if report.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(report.errors.count, "error") %> prohibited this report from being saved:</h2>

      <ul class="list-disc ml-6">
        <% report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div data-report-target="step" >
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-[90%] mx-auto relative text-center">
          <%= link_to root_path, class: "absolute text-[#FF6159] px-1 py-2 top-0 left-0 text-2xl" do %>
            <i class="fa-solid fa-angle-left"></i>
          <% end %>
          <h1 class="text-2xl font-meduim text-[#FF6159]">รายงานไฟไหม้</h1>
          <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
        </div>

        <%= render "upload_image", form:form %>
      
        <div class="flex justify-end w-[90%]">
          <button 
            type="button"
            id="upload-step-next"
            disabled
            data-testid="upload-step-next-button"
            data-action="click->report#next"
            class="flex items-center justify-center gap-2 text-lg px-1 py-3 rounded-xl text-[#FF6159] hover:scale-[1.01] hover:text-[#FF6C64] transition-all opacity-50 mt-3 cursor-pointer">
            <span>ถัดไป</span>
            <i class="fa-solid fa-angle-right"></i>
          </button>
        </div>
      </div>
    </div>

    <div data-report-target="step" >
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-full flex flex-col items-center">
          <div class="w-[90%] mx-auto relative text-center">
            <button 
              type="button"
              data-action="click->report#prev"
              class="absolute px-0 top-0 left-0 text-2xl text-[#FF6159] cursor-pointer hover:scale-[1.01] hover:text-[#FF6C64] transition-all">
              <i class="fa-solid fa-angle-left"></i>
            </button>
            <h1 class="text-2xl font-meduim text-[#FF6159]">ระบุรายละเอียด</h1>
            <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
          </div>

          <%= render "detail", form: form %>
        </div>
      
        <div class="flex justify-end w-[90%]">
          <button 
            type="button"
            data-testid="detail-step-next-button"
            data-action="click->report#next"
            class="flex items-center justify-center gap-2 text-lg px-1 py-3 rounded-xl text-[#FF6159] cursor-pointer hover:scale-[1.01] hover:text-[#FF6C64] transition-all">
            <span>ถัดไป</span>
            <i class="fa-solid fa-angle-right"></i>
          </button>
        </div>
      </div>
    </div>

    <div data-report-target="step" class="hidden">
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-full h-full flex flex-col items-center">
          <div class="w-[90%] relative text-center">
            <button 
              type="button"
              data-action="click->report#prev"
              class="absolute px-0 top-0 left-0 text-2xl text-[#FF6159] cursor-pointer hover:scale-[1.01] hover:text-[#FF6C64] transition-all">
              <i class="fa-solid fa-angle-left"></i>
            </button>
            <h1 class="text-2xl font-meduim text-[#FF6159]">ระบุตำแหน่งไฟไหม้</h1>
            <p id="location-name" class="mt-2 text-base w-[80%] line-clamp-1 mx-auto text-gray-500">กำลังหาตำแหน่ง...</p>
            <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
          </div>

          <div data-report-target="locationContainer" data-controller="location" data-action="report:initMap->location#initMap" data-location-user-areas-value="<%=@user_areas%>" class="w-[90%] h-full mt-3">
            <%= render "location" %>
            <%= form.hidden_field :lat, data: { location_target: "lat" } %>
            <%= form.hidden_field :long, data: { location_target: "long" } %>
            <%= form.hidden_field :location_name, data: { location_target: "locationName" } %>
            <%= form.hidden_field :area_ids, data: { location_target: "areaId" } %>
          </div>
        </div>

        <div class="w-[90%] inset-0"  data-controller="bottom-sheet" >
          <button
            type="button"
            id="submit"
            disabled
            data-action="click->bottom-sheet#open"
            data-testid="send-report-button"
            class="absolute bottom-4 z-50 left-0 right-0 w-[90%] text-white mx-auto disabled:hover:bg-gray-200 disabled:scale-100 text-lg px-1 py-3 rounded-xl text-center hover:scale-[1.01] cursor-pointer transition-all">
            ส่งรายงาน
          </button>  
          
          <%= render "confirm", form: form %>
        </div>
      </div>
    </div>
<% end %>
