<%= form_with(model: report, class: "contents", data: { "report-step-value" => "0" }) do |form| %>
  <% if report.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(report.errors.count, "error") %> prohibited this report from being saved:</h2>

      <ul class="list-disc ml-6">
        <% report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div data-report-target="step" >
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-[90%] mx-auto relative text-center">
          <h1 class="text-2xl font-semibold text-[#FF6159]">รายงานไฟไหม้</h1>
          <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
        </div>

        <%= render "upload_image", form:form %>
      
        <div class="flex justify-end w-[90%]">
          <%= button_helper("ถัดไป", iconEnd: "angle-right", size: 'lg', variant: 'plain', id: "upload-step-next", data: { "action": "click->report#next" }, css_class: "opacity-50 mt-3", disabled: true) %>
        </div>
      </div>
    </div>

    <div data-report-target="step" >
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-full flex flex-col items-center">
          <div class="w-[90%] mx-auto relative text-center">
            <%= button_helper("", icon: "angle-left", size: 'xl', variant: 'plain', css_class: 'absolute px-0 top-0 left-0', data: { "action": "click->report#prev" }) %>
            <h1 class="text-2xl font-semibold text-[#FF6159]">ระบุรายละเอียด</h1>
            <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
          </div>

          <%= render "detail", form: form %>
        </div>
      
        <div class="flex justify-end w-[90%]">
          <%= button_helper("ถัดไป", iconEnd: "angle-right", size: 'lg', variant: 'plain', data: { "action": "click->report#next" }) %>
        </div>
      </div>
    </div>

    <div data-report-target="step" class="hidden">
      <div class="h-svh overflow-y-scroll w-full flex flex-col items-center py-6 justify-between">
        <div class="w-full flex flex-col items-center">
          <div class="w-[90%] relative text-center">
            <%= button_helper("", icon: "angle-left", size: 'xl', variant: 'plain', css_class: 'absolute px-0 top-0 left-0', data: { "action": "click->report#prev" }) %>
            <h1 class="text-2xl font-semibold text-[#FF6159]">ระบุตำแหน่งไฟไหม้</h1>
            <p id="location-name" class="mt-2 text-base w-[80%] line-clamp-1 mx-auto text-gray-500">กำลังหาตำแหน่ง...</p>
            <p class="text-sm text-gray-500"><%= l(Time.current, format: :full, locale: :th) %></p>
          </div>

          <div data-report-target="locationContainer" 
              data-controller="location"
              data-action="report:initMap->location#initMap" 
              class="w-[90%] mt-3"> 
            <%= render "location" %>

            <div class="my-5">
              <%= form.hidden_field :lat, data: { location_target: "lat" }, class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": report.errors[:lat].none?, "border-red-400 focus:outline-red-600": report.errors[:lat].any?}] %>
            </div>

            <div class="my-5">
              <%= form.hidden_field :long, data: { location_target: "long" }, class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": report.errors[:long].none?, "border-red-400 focus:outline-red-600": report.errors[:long].any?}] %>
            </div>

            <div class="my-5">
              <%= form.hidden_field :location_name, data: { location_target: "locationName" }, class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": report.errors[:long].none?, "border-red-400 focus:outline-red-600": report.errors[:long].any?}] %>
            </div>
          </div>
        </div>

        <div class="w-[90%] inset-0" data-controller="bottom-sheet">
          <%= button_helper("ส่งรายงาน", size: 'lg', css_class: 'absolute bottom-4 z-50 left-0 right-0 w-[90%] mx-auto bg-gray-200 disabled:hover:bg-gray-200' ,id: 'confirm', disabled: true, data: {action: "click->bottom-sheet#open"}) %>
          <%= render "confirm", form: form %>
        </div>
      </div>
    </div>
<% end %>
