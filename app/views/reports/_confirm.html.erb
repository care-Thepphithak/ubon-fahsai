<%= render "shared/bottom_sheet" do %>
    <h2 class="text-2xl text-[#FF6159] pb-[20px]">ส่งรายงานไฟไหม้</h2>
    <p class="text-base text-gray-500 pb-[10px]">ตำบลในเมือง อำเภอเมือง</p>
    <p class="text-xl text-gray-500 pb-[30px]">27 มกราคม 2567 เวลา 13:00 น.</p>

    <%= form.submit "ยืนยัน", data: { action: "click->bottom-sheet#submit" }, class:["cursor-pointer bg-[#FF6159] w-full text-white hover:bg-[#FF6C64] text-lg px-1 py-3 rounded-xl flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.01] transition-all"] %>
    <%= button_helper("ยกเลิก", size: 'lg', variant: 'cancel', data: { "action": "click->bottom-sheet#close" }, css_class: 'w-full') %>
<% end %>